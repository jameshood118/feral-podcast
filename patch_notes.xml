```python
import json
import os

if os.path.exists('captains_log.json'):
    with open('captains_log.json', 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    entries = data.get('entries', [])
    feral_updates = []
    for e in entries:
        text = f"{e.get('subject', '')} {e.get('primary_data', '')} {e.get('secondary_data', '')}".lower()
        if 'feral' in text or 'podcast' in text:
            feral_updates.append(e)
            
    print(f"Found {len(feral_updates)} feral/podcast entries.")
    for e in feral_updates:
        print(f"---")
        print(f"Date: {e.get('timestamp')}")
        print(f"Subject: {e.get('subject')}")
        print(f"Primary: {e.get('primary_data')}")
        print(f"Secondary: {e.get('secondary_data')}")
else:
    print("captains_log.json not found in the environment.")

