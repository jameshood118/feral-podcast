```python
import glob
import json
import os

all_jsons = glob.glob('**/*.json', recursive=True)
feral_updates = []

for jf in all_jsons:
    try:
        with open(jf, 'r') as f:
            d = json.load(f)
            entries = d.get('entries', []) if isinstance(d, dict) else (d if isinstance(d, list) else [])
            for e in entries:
                if not isinstance(e, dict): continue
                text = f"{e.get('subject', '')} {e.get('primary_data', '')} {e.get('secondary_data', '')} {str(e.get('tags', []))}".lower()
                if 'feral' in text or 'podcast' in text:
                    e['_source_file'] = jf
                    feral_updates.append(e)
    except Exception:
        pass

print(f"Found {len(feral_updates)} feral/podcast entries.")
for e in feral_updates:
    print(f"File: {e['_source_file']}, Date: {e.get('timestamp')}, Sub: {e.get('subject')}")


